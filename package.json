{
  "name": "@matfire/janitor",
  "version": "2.1.0",
  "description": "Making sure your code is clean and secure before it ships to production.",
  "homepage": "https://github.com/getjanitor/janitor#readme",
  "bugs": {
    "url": "https://github.com/getjanitor/janitor/issues"
  },
  "license": "MIT",
  "author": "Matteo Gassend <matteo@matteogassend.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getjanitor/janitor.git"
  },
  "bin": {
    "janitor": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "arktype": "^2.2.3",
    "cleye": "3.0.0-beta.1",
    "liquidjs": "^10.27.2",
    "minimatch": "^10.2.5",
    "octokit": "^5.0.5",
    "smol-toml": "^1.7.1",
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
