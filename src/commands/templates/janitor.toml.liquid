# Janitor CLI version used by the generated GitHub Actions workflow.
version = {= janitor_version | json_string =}

[review]
# Append per-run model token usage and estimated cost to the main review comment.
track_spend = false

# Re-review only what changed since Janitor's last successful review of the pull request.
# Set to false to review the full diff on every run.
# incremental = true

# Run a review when at least one changed path matches one of these glob patterns.
tracked_paths = [
{% for tracked_path in tracked_paths %}  {= tracked_path | json_string =}{% unless forloop.last %},{% endunless %}
{% endfor %}]

# Skip pull requests whose head branch matches one of these glob patterns, such as
# automated release branches. Exclusions take precedence over included_branches.
# excluded_branches = ["release/**"]
# Review only pull requests whose head branch matches one of these glob patterns.
# included_branches = ["**"]

# Model reasoning effort: off, minimal, low, medium, high, xhigh, or max. Omitted means
# medium. Levels above what the configured model supports are lowered to its maximum.
# thinking_level = "high"

# Report a "Janitor" check run on the head commit that passes only when the review's
# confidence (1 to 5) reaches min_confidence. Make it a required status check in branch
# protection to block merges. Needs the workflow's checks: write permission
# (`janitor init --merge-check`).
{% if merge_check %}[review.merge_check]
min_confidence = 4
{% else %}# [review.merge_check]
# min_confidence = 4
{% endif %}