# Generated by Janitor. Regenerate this workflow after changing `version` in janitor.toml.
name: Janitor

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    # Secrets and write tokens are intentionally unavailable to pull requests from forks.
    if: >-
      !github.event.pull_request.draft &&
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    steps:
      - name: Check out pull request
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.sha }}
      - name: Set up Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 22
      - name: Review pull request
        run: npx --yes {= janitor_package | json_string =} review
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          JANITOR_MODEL: ${{ secrets.JANITOR_MODEL }}
          JANITOR_PROVIDER: ${{ secrets.JANITOR_PROVIDER }}
          JANITOR_PROVIDER_KEY: ${{ secrets.JANITOR_PROVIDER_KEY }}
