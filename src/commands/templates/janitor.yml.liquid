# Generated by Janitor. Regenerate this workflow after changing `version` in janitor.toml.
name: Janitor

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: janitor-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  review:
    # Secrets and write tokens are intentionally unavailable to pull requests from forks.
    if: >-
      !github.event.pull_request.draft &&
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    steps:
      - name: Check out pull request
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.sha }}
{% if github_app %}      - name: Create GitHub App token
        id: app-token
        uses: actions/create-github-app-token@v3
        with:
          client-id: ${{ vars.JANITOR_APP_CLIENT_ID }}
          private-key: ${{ secrets.JANITOR_APP_PRIVATE_KEY }}
          repositories: ${{ github.event.repository.name }}
          permission-contents: write
          permission-pull-requests: write
{% endif %}      - name: Set up Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 22
      - name: Review pull request
        run: npx --yes {= janitor_package | json_string =} review
        env:
          GITHUB_TOKEN: {% if github_app %}${{ steps.app-token.outputs.token }}{% else %}${{ secrets.GITHUB_TOKEN }}{% endif %}
          JANITOR_VERBOSE: ${{ vars.JANITOR_VERBOSE }}
          JANITOR_QUIET: ${{ vars.JANITOR_QUIET }}
          JANITOR_MODEL: ${{ secrets.JANITOR_MODEL }}
          JANITOR_PROVIDER: ${{ secrets.JANITOR_PROVIDER }}
          JANITOR_PROVIDER_KEY: ${{ secrets.JANITOR_PROVIDER_KEY }}
